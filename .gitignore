# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Runtime state, not source.
# data/ruleforge.db is ~43MB of local history, fixtures and mapping overrides.
# It is created on first run and is machine-specific, so it must never be committed.
data/*.db
data/*.sqlite
data/*.sqlite3

# Editor / agent tooling state
.kilo/
.DS_Store
Thumbs.db

# Local environment overrides
.env
.env.*

# RuleForge history: pasted detection rules and EVENT SAMPLES, which contain
# hostnames, usernames, source IPs and destination IPs. Filesystem permissions
# are 0600 and the server never transmits them, but git add -A from a repo
# with a remote would publish them. This is the one file RuleForge writes.
#
# THE PATH IS NOW `data/`, NOT `ruleforge/data/`. The package was flattened, so
# the directory moved up one level -- and an ignore rule that names a directory
# that no longer exists matches nothing at all. That failure is silent: there is
# no error, no warning, and `git add -A` simply starts offering the analyst's
# pasted rules and their machine's hostnames for commit. `git check-ignore` is
# the only thing that catches it, so it is worth running after any move.
data/

